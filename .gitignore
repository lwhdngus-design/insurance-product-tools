# 실제 회사 문서(PDF)가 실수로 커밋·푸시되지 않도록 차단 — 교육용 가상 샘플만 허용
*.pdf
!product-search/sample-기초서류폴더/**/*.pdf

# 로컬 실행기(serve.py)가 만드는 파일 — PDF에서 읽은 글자 캐시와 내 PC 폴더 경로
product-search/.docs-cache/
product-search/docs-folder.txt

# 파이썬 실행 시 생기는 임시 파일
__pycache__/

# 공시실 다운로드 결과와 로컬 로그
product-documents/
**/download_log.csv
